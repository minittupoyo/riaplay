{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "riaplay",
  "version": "0.1.1",
  "identifier": "net.minittu.riaplay",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "riaplay",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/downloads/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libmpv2"
        ]
      },
      "rpm": {
        "depends": [
          "mpv-libs"
        ]
      }
    }
  }
}
